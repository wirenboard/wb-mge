CompileFlags:
  # Use the compile_commands.json generated by ESP-IDF build system
  # It contains all -I include paths for IDF components and managed components
  # Each signature builds into its own directory (BUILD_DIR in the Makefile),
  # so this names the default TARGET's directory; point it at another
  # signature's directory when working on that board
  CompilationDatabase: build/mge_v3
  # Remove xtensa-specific flags that host clangd does not understand
  Remove:
    - -mlongcalls
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=*
    - -fno-builtin-memcpy
    - -fno-builtin-memset
    - -fno-builtin-bzero
    - -fno-builtin-stpcpy
    - -fno-builtin-strncpy
    - -fdiagnostics-color=*
