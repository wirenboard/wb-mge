# Secrets
.env
.env.*
!.env.example

# VS Code Settings
.vscode/
wb-mge.code-workspace

# JetBrains IDEA
.idea

# Build
build/**
# Generated sdkconfig files: sdkconfig.<signature> (one per MODEL_LIST entry in
# the Makefile), sdkconfig.qemu_build, a bare sdkconfig from a manual idf.py run,
# and the .old backup idf.py leaves next to each. Matched by pattern so that
# signatures are named only in MODEL_LIST, and anchored with / so the pattern
# cannot reach nested paths such as unittests/mocks/sdkconfig.h. The negations
# re-include the checked-in inputs (note !/sdkconfig.qemu.* assumes a generated
# QEMU config is never named sdkconfig.qemu.<something>: today's has an
# underscore), and the trailing /sdkconfig.*.old wins over them for their backups.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
!/sdkconfig.defaults.*
!/sdkconfig.qemu.*
/sdkconfig.*.old
**/build/

# Release
release/

# Dependencies
managed_components/

.clang-format

# Coverage reports
**/covr_report/
*.gcov

# One-e2e-run-per-working-tree lock (api_tests/tree_lock.py). Lives in the repo root
# rather than under build/ precisely because nothing here deletes it mid-run — see that
# module for why a lock file that a build step can remove is not a lock at all.
/.e2e-tree.lock

# Python
__pycache__
.venv/
api_tests/.venv/


eim_config.toml
