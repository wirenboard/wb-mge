# Extra sdkconfig overrides for QEMU builds.
# Applied on top of sdkconfig.qemu.minimal (which is auto-generated).
# Add any QEMU-specific config options here instead of editing the generated file.

CONFIG_HTTPD_WS_SUPPORT=y

# Increase the lwIP socket pool for QEMU test runs.
# The table-exhaustion test opens 9 simultaneous Modbus TCP connections, and
# the system also needs sockets for httpd, the transparent-TCP listen socket,
# mDNS (IPv4 + IPv6), DHCP, etc.  15 (the hardware default) is not enough;
# 20 gives comfortable headroom without impacting the QEMU memory budget.
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_SPIRAM=y

# Use a QEMU-specific partition table with factory + ota_0 + ota_1.
# sdkconfig.qemu.minimal defaults to single-app (partitions_singleapp.csv),
# which makes esp_ota_get_next_update_partition() return NULL.
# partitions_qemu.csv adds a factory partition at 0x10000 (where qemu_mge.bin
# is loaded) and ota_0/ota_1 targets so /update can actually write firmware.
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_qemu.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_qemu.csv"

# Virtual eFuse so main/sys_info.c can write the device signature at boot
# (write_device_signature_to_efuse() is guarded by #if CONFIG_EFUSE_VIRTUAL).
# Without this the signature stays empty and the OTA handler rejects any
# upload with "Device signature is empty, OTA not allowed".
CONFIG_EFUSE_VIRTUAL=y
