#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_table.csv"

#
# HTTP Server
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#
# FreeRTOS / Kernel
#
# RTOS frequency increased to improve task switching speed and
# accuracy of timeouts and delays (vTaskDelay)
#
CONFIG_FREERTOS_HZ=500

#
# LWIP
#
CONFIG_LWIP_MAX_SOCKETS=15
CONFIG_LWIP_STATS=y

# Task Watchdog Timer panic on timeout (reset system)
CONFIG_ESP_TASK_WDT_PANIC=y

# Preparing for a firmware update may take about 5-7 seconds
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

#
# ADC Calibration Configurations
#
# Disable ADC two-point calibration because really these calibrations
# are are not present in the eFuse (bytes 12-15 in block 3) and to
# prevent conflict with device signature stored in block 3
CONFIG_ADC_CALI_EFUSE_TP_ENABLE=n

#
# Enable DEBUG log messages activated by esp_log_level_set()
#
# Only for debug purposes, must be disabled in production!
#
# CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# CONFIG_LOG_MAXIMUM_LEVEL=4

#
# eFuse Bit Manager
#
# Only for debug purposes, must be disabled in production!
#
# CONFIG_EFUSE_VIRTUAL=y

#
# PSRAM (SPI RAM)
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_PICO_PSRAM_CS_IO=9
# Allow boot without PSRAM chip; esp_psram_is_initialized() will return false
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

#
# UART driver allocations (mutexes, ring buffers) must stay in internal RAM.
# Without this, UART_MALLOC_CAPS = MALLOC_CAP_DEFAULT, which with SPIRAM enabled
# can route semaphore/ring-buffer allocations to PSRAM, causing LoadProhibited
# crashes in xQueueSemaphoreTake when PSRAM cache is unavailable (e.g. in uart_flush_input).
# Setting this forces UART_MALLOC_CAPS = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT.
#
CONFIG_UART_ISR_IN_IRAM=y

#
# ADC oneshot driver control structures must stay in internal RAM.
# Without this, ADC_MEM_ALLOC_CAPS = MALLOC_CAP_DEFAULT, which with SPIRAM enabled
# allocates adc_oneshot_unit_ctx_t (incl. chan_configs[].bitwidth) to PSRAM.
# adc_oneshot_read() calls portENTER_CRITICAL() before reading from that struct,
# making PSRAM cache unavailable and causing HAL_ASSERT(false) in adc_oneshot_ll_set_output_bits.
# Setting this forces ADC_MEM_ALLOC_CAPS = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT.
#
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

#
# I2C master driver internal structures (semaphores, queues, bus context) must stay
# in internal RAM. Without this, I2C_MEM_ALLOC_CAPS = MALLOC_CAP_DEFAULT, which with
# SPIRAM enabled routes i2c_master_bus_t and its semaphores to PSRAM.
# i2c_master_transmit() calls xQueueSemaphoreTake on those semaphores, which can
# crash with LoadProhibited when PSRAM is not accessible (EXCVADDR in PSRAM range).
# Setting this forces I2C_MEM_ALLOC_CAPS = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT.
#
CONFIG_I2C_ISR_IRAM_SAFE=y
