#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_table.csv"

#
# HTTP Server
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#
# FreeRTOS / Kernel
#
# RTOS frequency increased to improve task switching speed and
# accuracy of timeouts and delays (vTaskDelay)
#
CONFIG_FREERTOS_HZ=500

#
# LWIP
#
# Socket budget. The pool has to cover, concurrently:
#   - httpd: MAX_OPEN_SOCKETS = 12 client sockets (main/http_server.c) + its listen socket
#   - the two bridge TCP servers: a listen socket each, plus their client sockets
#   - the cache Modbus TCP server: listen + client sockets
#   - the WebSocket sniffer stream
#   - system users: mDNS (IPv4 + IPv6), DHCP, etc.
# httpd alone can take 13 of them, so 15 leaves nothing for the bridges and the
# cache server, and the loser of the race gets an ESP_FAIL it cannot distinguish
# from a busy port (see the comment in main/settings_update.c). 20 is the value
# the QEMU test runs have been using.
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_STATS=y

# Task Watchdog Timer panic on timeout (reset system)
CONFIG_ESP_TASK_WDT_PANIC=y

# Preparing for a firmware update may take about 5-7 seconds
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

#
# ADC Calibration Configurations
#
# Disable ADC two-point calibration because really these calibrations
# are are not present in the eFuse (bytes 12-15 in block 3) and to
# prevent conflict with device signature stored in block 3
CONFIG_ADC_CALI_EFUSE_TP_ENABLE=n

#
# Enable DEBUG log messages activated by esp_log_level_set()
#
# Only for debug purposes, must be disabled in production!
#
# CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# CONFIG_LOG_MAXIMUM_LEVEL=4

#
# eFuse Bit Manager
#
# Only for debug purposes, must be disabled in production!
#
# CONFIG_EFUSE_VIRTUAL=y
